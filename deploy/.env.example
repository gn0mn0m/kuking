# Жарко: настройки сервера. Копию заполняет scripts/gen-secrets.sh (пароли и ключи — случайные).
# Этот файл (.env) — секретный: не публиковать, не пересылать, не коммитить.

# --- адрес сервера ---
# бесплатно без покупки домена: IP с дефисами + .sslip.io, например 203-0-113-7.sslip.io
DOMAIN=CHANGE_ME
# CORS: какой сайт может обращаться к API из браузера. Пусто = только само приложение, https://DOMAIN
# (фронтенд раздаётся с этого же сервера). Другой адрес — только на время разработки, например http://localhost:8080.
# Не ставь * : тогда к API сможет обращаться скрипт с любого сайта.
CORS_ORIGIN=
# куда вести ссылки из писем (если включишь почту) — сам сервер; gen-secrets.sh ставит https://DOMAIN/
SITE_URL=CHANGE_ME
ADDITIONAL_REDIRECT_URLS=
# папка с фронтендом на сервере (её подключает Caddy)
WEB_ROOT=/srv/zharko-web

# --- секреты базы и входа (генерирует gen-secrets.sh) ---
POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
ANON_KEY=CHANGE_ME
SERVICE_ROLE_KEY=CHANGE_ME
JWT_EXPIRY=3600

# --- регистрация ---
# true — входить сразу после регистрации, без письма (почтовый сервер не нужен)
ENABLE_EMAIL_AUTOCONFIRM=true
# true — закрыть регистрацию новых людей (когда все тестировщики уже зарегистрированы)
DISABLE_SIGNUP=false

# --- нейросеть: Yandex AI Studio (вписать руками, см. README, шаг 4) ---
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# модели текста по очереди (если первой нет — берётся следующая)
AI_MODELS=deepseek-v4.1-flash
AI_IMAGE_MODEL=aliceai-image-art-3.0
AI_IMAGE_SIZE=1024x1024
AI_MAX_TOKENS=16000
# защита бюджета: запросов на человека за 24 часа (0 — без лимита)
AI_DAILY_TEXT_LIMIT=60
AI_DAILY_IMAGE_LIMIT=20
# сколько платных ответов модели максимум на один строгий вызов (рецепт/план)
AI_FN_MAX_ATTEMPTS=3

# --- почта (необязательно, см. README «Почта») ---
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Жарко
