# Жарко: HTTPS, сам фронтенд (PWA) и API — всё с одного российского сервера, ничего не грузится из-за рубежа.
# Сертификат Let's Encrypt Caddy получает и продлевает сам — нужен только DOMAIN в .env и открытые порты 80/443.
#   /auth/v1/*      → auth:9999      (вход, регистрация, обновление токена)
#   /rest/v1/*      → rest:3000      (таблицы и rpc)
#   /functions/v1/* → functions:9000 (ai, birthday-push)
#   всё остальное   → статика из /srv/zharko-web (её кладёт scripts/deploy-web.sh)
# Приложение шлёт заголовок apikey — здесь он просто игнорируется: права решают токен входа и RLS в базе.

(cors) {
	header {
		# только адрес самого приложения: CORS_ORIGIN из .env, по умолчанию https://DOMAIN (см. docker-compose.yml)
		Access-Control-Allow-Origin "{$CORS_ORIGIN}"
		Access-Control-Allow-Headers "authorization, apikey, content-type, prefer, range, x-client-info, accept-profile, content-profile, x-supabase-api-version"
		Access-Control-Allow-Methods "GET, POST, PATCH, PUT, DELETE, OPTIONS"
		Access-Control-Expose-Headers "Content-Range, X-Total-Count"
		Access-Control-Max-Age "86400"
		Vary "Origin"
		defer
	}
}

(api) {
	handle_path /auth/v1/* {
		import cors
		@preflight method OPTIONS
		respond @preflight 204
		reverse_proxy auth:9999
	}
	handle_path /rest/v1/* {
		import cors
		@preflight method OPTIONS
		respond @preflight 204
		encode zstd gzip
		reverse_proxy rest:3000
	}
	# функции сами отвечают на OPTIONS и ставят CORS (как в облаке); поток SSE отдаём без буфера
	handle_path /functions/v1/* {
		reverse_proxy functions:9000 {
			flush_interval -1
		}
	}
}

# снаружи: HTTPS на домене (HTTP сам перенаправляется на HTTPS)
{$DOMAIN} {
	import api

	# фронтенд «Жарко»
	handle {
		root * /srv/www
		encode zstd gzip
		# оболочка, воркер и манифест — всегда свежие (обновления приходят сразу); остальное кэширует сам воркер
		@fresh path / /index.html /sw.js /manifest.webmanifest
		header @fresh Cache-Control "no-cache"
		@fonts path /fonts/*
		header @fonts Cache-Control "public, max-age=31536000, immutable"
		@webmanifest path *.webmanifest
		header @webmanifest Content-Type "application/manifest+json"
		file_server
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		# всё своё: скрипты, стили, шрифты, API — только с этого домена; картинки еще из data: и blob: (фото блюд)
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}
}

# внутри docker-сети: тот же API без HTTPS — для функций (SUPABASE_URL=http://caddy:8000). Порт наружу не открыт.
http://:8000 {
	import api
	handle {
		respond 404
	}
}
